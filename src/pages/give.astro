---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { settings, givingHref } from '../lib/settings';

const g = settings.giving;
const embed = g.provider === 'subsplash' && g.url;
const isPco = g.provider === 'planning-center' && g.url;
---
<BaseLayout title="Give" description={`Give online to ${settings.churchName}, a Southern Baptist church plant in Coldwater, Mississippi.`}>
  <PageHero
    title="Give to Redemption Church Coldwater"
    lede="Your generosity helps us proclaim Christ, cultivate community, and make disciples in Coldwater and Tate County."
  />

  <section class="section">
    <div class="container give-grid">
      <div class="stack give-info" data-reveal>
        <h2 class="h2">Give online</h2>
        {g.note && <p class="lede">{g.note}</p>}
        <blockquote class="verse">
          <p>“I thank my God in all my remembrance of you … because of your partnership in the gospel from the first day until now.”</p>
          <cite>Philippians 1:3–5</cite>
        </blockquote>
        {g.mailingAddress && (
          <div class="by-check">
            <Icon name="mail" />
            <div>
              <h3 class="by-check-title">Give by check</h3>
              <p class="muted">Make checks payable to:</p>
              <address>{g.mailingAddress.split('\n').map((l) => <>{l}<br /></>)}</address>
            </div>
          </div>
        )}
        <p class="muted">Want to support the church plant monthly? <a href="/partner">See ways to partner</a>.</p>
      </div>

      <div class="give-form" data-reveal>
        {embed ? (
          <iframe src={g.url!} title="Online giving form" loading="lazy" allow="payment"></iframe>
        ) : (
          <div class="give-fallback stack">
            <h3 class="h3">Give securely online</h3>
            <p>Give once or set up recurring giving.</p>
            <a class="btn" href={givingHref} target={isPco ? undefined : '_blank'} rel="noopener">Give online <Icon name="arrow" /></a>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

{isPco && <script is:inline src="https://js.churchcenter.com/modal/v1" defer></script>}

<style>
  .give-grid { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 980px) { .give-grid { grid-template-columns: 1fr 1fr; gap: 72px; } }
  .give-info { --stack: 22px; }
  .give-info a:not(.btn) { color: var(--accent-text); font-weight: 600; text-underline-offset: 3px; }
  .verse { margin: 8px 0; padding-left: 22px; border-left: 4px solid var(--color-accent); }
  .verse p { font-family: var(--font-display); font-weight: 700; font-style: italic; font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.35; color: var(--color-ink); }
  .verse cite { display: block; margin-top: 10px; font-style: normal; font-weight: 600; color: var(--accent-text); letter-spacing: .15em; text-transform: uppercase; font-size: .78rem; }
  .by-check { display: flex; gap: 16px; padding: 22px 24px; border-radius: var(--radius); background: var(--color-sand); }
  .by-check :global(svg) { flex: none; color: var(--accent-text); margin-top: 2px; }
  .by-check-title { font-family: var(--font-body); font-size: 1rem; font-weight: 700; color: var(--color-ink); line-height: 1.4; }
  .by-check address { font-style: normal; font-weight: 600; margin-top: 4px; }
  .give-form {
    border-radius: var(--radius-lg); overflow: hidden; background: var(--color-surface);
    border: 1px solid var(--color-line); box-shadow: 0 24px 60px rgb(2 26 38 / 0.10);
  }
  .give-form iframe { display: block; width: 100%; height: 680px; border: 0; }
  .give-fallback { padding: 40px; }
</style>
