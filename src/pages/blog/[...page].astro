---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getPosts } from '../../lib/content';
import { siteConfig } from '../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.featured) ?? posts[0];
  const rest = posts.filter((p) => p !== featured);
  const usedCategories = [...new Set(posts.map((p) => p.data.category))];
  return paginate(rest, { pageSize: siteConfig.postsPerPage, props: { featured, usedCategories } });
}) satisfies GetStaticPaths;

const { page, featured, usedCategories } = Astro.props;
const first = page.currentPage === 1;
---
<BaseLayout title={first ? 'Blog' : `Blog — Page ${page.currentPage}`} description="Stories, teaching, and updates from our church family.">
  <PageHero eyebrow="Blog" title="Stories & updates" lede="Teaching, stories, and news from our church family." />
  <BlogIndex
    posts={page.data}
    featured={first ? featured : undefined}
    usedCategories={usedCategories}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</BaseLayout>
