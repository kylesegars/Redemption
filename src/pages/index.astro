---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EventSlider from '../components/EventSlider.astro';
import PostCard from '../components/PostCard.astro';
import { settings, cityState } from '../lib/settings';
import { getUpcomingEvents, getPosts } from '../lib/content';
import { siteConfig } from '../site.config';

const events = (await getUpcomingEvents()).slice(0, siteConfig.homeEventCount);
const posts = (await getPosts()).slice(0, 3);
const city = settings.location.city ?? 'our city';
---
<BaseLayout overlayHeader>
  <!-- Hero -->
  <section class="hero on-image">
    <img class="hero-bg" src="/images/site/hero.svg" alt="" fetchpriority="high" />
    <div class="container hero-inner">
      <span class="eyebrow">A new church for {cityState || city}</span>
      <h1 class="hero-title">Find your<br />people.<br /><span>Find hope.</span></h1>
      <div class="hero-bottom">
        <p class="lede">
          {settings.churchName} is a new church family for everyone in {city} — whether you've followed
          Jesus for years or you're just curious.
        </p>
        <div class="btn-row">
          <a class="btn" href="/contact#visit" data-plan-visit>Plan a visit <Icon name="arrow" /></a>
          <a class="btn btn-outline" href="/about">Our story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service info strip -->
  <section class="info-strip section-dark">
    <div class="container info-grid">
      <div class="info-item">
        <Icon name="clock" />
        <div>
          <p class="info-label">Gather with us</p>
          {settings.serviceTimes.map((s) => <p class="info-value">{s.day} · {s.time}</p>)}
        </div>
      </div>
      <div class="info-item">
        <Icon name="pin" />
        <div>
          <p class="info-label">Location</p>
          <p class="info-value">{settings.location.venue}</p>
          {settings.location.mapUrl && <a class="info-link" href={settings.location.mapUrl} target="_blank" rel="noopener">Get directions</a>}
        </div>
      </div>
      <div class="info-item">
        <Icon name="smile" />
        <div>
          <p class="info-label">Kids</p>
          <p class="info-value">{settings.serviceTimes[0]?.note ?? 'Kids program every week'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission / intro -->
  <section class="section">
    <div class="container intro">
      <div class="intro-copy stack" data-reveal>
        <span class="eyebrow">Who we are</span>
        <p class="statement">
          We're a church for {city} — a family of ordinary people learning to love God,
          love each other, and <em>love our city</em> the way Jesus does.
        </p>
        <a class="link-arrow" href="/about">More about us <Icon name="arrow" /></a>
      </div>
      <div class="intro-media" data-reveal>
        <div class="media tall"><img src="/images/site/community.svg" alt="" loading="lazy" /></div>
        <div class="media small"><img src="/images/site/worship.svg" alt="" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- Events slider -->
  <section class="section section-dark events-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">What's happening</span>
          <h2>Upcoming events</h2>
        </div>
      </div>
      <EventSlider events={events} />
      <p class="events-all"><a class="btn btn-light" href="/events">See all events <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Next steps -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Next steps</span>
          <h2>Be part of the story</h2>
        </div>
        <p class="lede">Every church plant is built by people who say yes. Here's how to get connected.</p>
      </div>
      <div class="steps">
        {[
          { title: 'Visit on a Sunday', text: 'Come as you are. We’ll save you a seat and help you find your way.', href: '/contact#visit', img: '/images/site/visit.svg', visit: true },
          { title: 'Partner with us', text: 'Pray, give, or join the launch team as we plant a church in ' + city + '.', href: '/partner', img: '/images/site/partner.svg' },
          { title: 'Give', text: 'Your generosity helps us reach our neighbors and serve our city.', href: '/give', img: '/images/site/give.svg' },
        ].map((s, i) => (
          <a class="step on-image" href={s.href} data-plan-visit={s.visit ? '' : undefined} data-reveal style={`transition-delay:${i * 80}ms`}>
            <img src={s.img} alt="" loading="lazy" />
            <div class="step-copy">
              <span class="step-num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
              <span class="step-arrow"><Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="section section-sand">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">From the blog</span>
            <h2>Latest stories</h2>
          </div>
          <a class="link-arrow" href="/blog">View all posts <Icon name="arrow" /></a>
        </div>
        <div class="post-grid">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: var(--color-on-dark); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--hero-overlay); }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg { animation: hero-zoom 18s ease-out both; }
    @keyframes hero-zoom { from { transform: scale(1.08); } }
  }
  .hero-inner { position: relative; z-index: 2; display: grid; gap: 28px; padding-top: calc(var(--header-height) + 60px); padding-bottom: clamp(48px, 7vw, 96px); }
  .hero .eyebrow { color: var(--color-on-dark); }
  .hero-title { font-size: clamp(3.3rem, 11vw, 10rem); line-height: 0.9; }
  .hero-title span { color: var(--color-accent); }
  .hero-bottom { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 28px 48px; }
  .hero .lede { color: color-mix(in srgb, var(--color-on-dark) 88%, transparent); max-width: 46ch; }
  /* Keep hero buttons clear of the floating Plan a Visit button on phones */
  @media (max-width: 600px) { .hero-bottom .btn-row { padding-right: 110px; } }

  .info-strip { padding-block: 36px; border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 15%, transparent); }
  .info-grid { display: grid; gap: 28px; }
  @media (min-width: 800px) { .info-grid { grid-template-columns: repeat(3, 1fr); } }
  .info-item { display: flex; gap: 16px; align-items: flex-start; }
  .info-item > :global(svg) { flex: none; width: 28px; height: 28px; color: var(--color-accent); }
  .info-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: .65; }
  .info-value { font-weight: 600; font-size: 1.1rem; }
  .info-link { font-size: 0.95rem; text-underline-offset: 3px; }

  .intro { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 960px) { .intro { grid-template-columns: 1.1fr 1fr; gap: 80px; } }
  .intro-copy { --stack: 28px; }
  .statement {
    font-family: var(--font-display); font-stretch: 100%; font-weight: 600;
    font-size: clamp(1.7rem, 3.3vw, 2.8rem); line-height: 1.15; letter-spacing: -0.01em;
  }
  .statement em { font-style: normal; color: var(--color-accent); }
  .intro-media { position: relative; padding-bottom: 18%; }
  .intro-media .tall { aspect-ratio: 4 / 5; width: 78%; }
  .intro-media .small { position: absolute; right: 0; bottom: 0; width: 48%; aspect-ratio: 1; border: 8px solid var(--color-bg); }

  .events-section .section-head { margin-bottom: clamp(32px, 5vw, 64px); }
  .events-all { margin-top: 48px; }

  .steps { display: grid; gap: 20px; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step {
    position: relative; overflow: hidden; border-radius: var(--radius-lg);
    min-height: 460px; display: flex; align-items: flex-end;
    color: var(--color-on-dark); text-decoration: none;
  }
  .step img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .step::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, transparent 30%, rgb(0 0 0 / .75)); }
  .step:hover img { transform: scale(1.06); }
  .step-copy { position: relative; z-index: 2; display: grid; gap: 10px; padding: 28px; width: 100%; }
  .step-num { font-family: var(--font-display); font-weight: 800; font-stretch: var(--display-stretch); color: var(--color-accent); }
  .step-copy p { opacity: .85; max-width: 32ch; }
  .step-arrow {
    position: absolute; right: 24px; top: -28px; width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center; background: var(--color-on-dark); color: var(--color-ink);
    transition: transform .3s ease, background-color .3s ease, color .3s ease;
  }
  .step:hover .step-arrow { transform: rotate(-45deg); background: var(--color-accent); color: var(--color-accent-ink); }

  .post-grid { display: grid; gap: 40px 28px; }
  @media (min-width: 760px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .post-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
