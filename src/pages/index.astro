---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EventSlider from '../components/EventSlider.astro';
import PostCard from '../components/PostCard.astro';
import { settings, fullAddress } from '../lib/settings';
import { getUpcomingEvents, getPosts } from '../lib/content';
import { siteConfig } from '../site.config';
import JsonLd from '../components/JsonLd.astro';
import { homeSchema } from '../lib/schema';

const events = (await getUpcomingEvents()).slice(0, siteConfig.homeEventCount);
const posts = (await getPosts()).slice(0, 3);
const service = settings.serviceTimes[0];

/* Page copy lives here so the layout stays locked. Edit freely. */
const currentSeries = {
  title: 'Ecclesiastes',
  subtitle: 'Looking Above the Sun',
  text: 'Join us on Sunday mornings as we study the book of Ecclesiastes! To listen to the sermons from this series or some of our past series, visit our Facebook page.',
  image: '/images/blog/ecclesiastes-looking-above-the-sun/featuredImage.jpg',
};

const rhythms = [
  { name: 'Pulpit', img: '/images/site/pulpit.png', text: 'Gathered worship on Sunday mornings, pointing us upward to God.' },
  { name: 'Table', img: '/images/site/table.png', text: 'Community and Life on Life groups where strangers become family.' },
  { name: 'Square', img: '/images/site/square.png', text: 'Engaging Coldwater and the world through service and the gospel.' },
];
---
<BaseLayout
  title="Southern Baptist Church in Coldwater, MS"
  description={`${settings.churchName} is a Southern Baptist church in Coldwater, Mississippi. Join us ${service ? `${service.day} at ${service.time}` : 'on Sundays'} at ${fullAddress} for worship, Bible teaching, and fellowship.`}
>
  <JsonLd slot="head" data={homeSchema(Astro.site!)} />
  <!-- Hero -->
  <section class="hero on-image">
    <img class="hero-bg" src="/images/site/sanctuary.jpg" alt="" fetchpriority="high" />
    <div class="container hero-inner">
      <img class="hero-logo" src="/images/site/logo-horizontal.png" alt={settings.churchName} width="1313" height="438" />
      <h1 class="hero-title">Sunday worship in Coldwater, Mississippi</h1>
      <p class="hero-lede">
        Join us {service ? `${service.day} at ${service.time}` : 'this Sunday'} as we proclaim Christ, cultivate community, and make disciples in Tate County.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn" href="/contact#visit" data-plan-visit>Plan a visit <Icon name="arrow" /></a>
        {settings.location.mapUrl && (
          <a class="btn btn-outline" href={settings.location.mapUrl} target="_blank" rel="noopener"><Icon name="pin" /> <span class="addr-full">{fullAddress}</span><span class="addr-short">Directions</span></a>
        )}
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 120V60C240 10 480 0 720 30s480 70 720 20v70z" /></svg>
  </section>

  <!-- What to expect + current series -->
  <section class="section">
    <div class="container expect">
      <div class="stack expect-copy" data-reveal>
        <h2>What to expect on a Sunday</h2>
        <p class="lede">
          Our Sunday morning gatherings are a time when we come together to proclaim and exalt the saving
          gospel of Jesus Christ through worship, prayer, Bible teaching, giving, fellowship, and serving one
          another.
        </p>
        <p>
          We hope anyone who walks through the doors of Redemption Church feels welcomed, loved, and
          encouraged to follow Jesus.
        </p>
        <ul class="facts">
          {service && <li><Icon name="clock" /><span><strong>{service.day} · {service.time}</strong><br />{service.note}</span></li>}
          {fullAddress && <li><Icon name="pin" /><span><strong>{settings.location.venue}</strong><br />{fullAddress}</span></li>}
        </ul>
      </div>

      <article class="series" data-reveal>
        <div class="media series-media"><img src={currentSeries.image} alt={`${currentSeries.title}: ${currentSeries.subtitle}`} loading="lazy" /></div>
        <div class="series-copy stack">
          <h3 class="h3">Current sermon series: {currentSeries.title}, {currentSeries.subtitle}</h3>
          <p class="muted">{currentSeries.text}</p>
          {settings.social.facebook && (
            <a class="btn btn-dark" href={settings.social.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Listen on Facebook</a>
          )}
        </div>
      </article>
    </div>
  </section>

  <!-- Events -->
  <section class="section section-dark events-section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Upcoming events in Coldwater</h2>
        </div>
      </div>
      {events.length > 0 ? (
        <EventSlider events={events} />
      ) : (
        <div class="weekly">
          <img src="/images/site/pulpit.png" alt="" width="64" height="64" />
          <div>
            <h3 class="h3">Weekly Worship Service</h3>
            <p class="muted">Every {service ? `${service.day.replace(/s$/, '')} at ${service.time}` : 'Sunday'}{fullAddress && ` · ${fullAddress}`}</p>
          </div>
        </div>
      )}
      <p class="events-all"><a class="btn" href="/events">See all events <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Why Coldwater -->
  <section class="why on-image">
    <img class="why-bg" src="/images/site/coldwater-tower.jpg" alt="" loading="lazy" />
    <div class="container why-inner">
      <div class="stack" data-reveal>
        <h2>Why plant a church in Coldwater?</h2>
        <p class="why-quote">“A wonderful place to call home.”</p>
      </div>
      <div class="stack why-copy" data-reveal>
        <p>
          The Coldwater area is like many small towns in Mississippi. There are Dollar Generals less than a mile
          away from each other, an old town square, railroad tracks criss-crossing the roads, family farms, and
          endless wooded areas. Amid this scenic southern landscape, there is also brokenness, poverty,
          addiction, family issues, illness, and lostness.
        </p>
        <p>
          Even in Mississippi, the most religious state in the U.S., there is a great need for healthy new
          churches that preach the Word, are Christ-centered, gospel-proclaiming, and will missionally engage
          the community. We hope to be a light in the Coldwater and Tate County area and see the lost and far
          off from God experience <strong>redemption through Jesus</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Our story -->
  <section class="section">
    <div class="container story">
      <div class="media story-media" data-reveal><img src="/images/site/first-service.jpg" alt="Redemption Church Coldwater's first service" loading="lazy" /></div>
      <div class="stack story-copy" data-reveal>
        <h2>Our story: a building given for the gospel</h2>
        <p>
          In 2023, Longview Point Baptist Church was given a building by a church that had shut its doors. The
          keys were handed over with the hopes of seeing it filled and used once again to bring the gospel to
          Tate County.
        </p>
        <p>
          At the same time, Longview Point had connected with Sam Henderson about becoming a church planting
          resident. In January 2024, Sam and family (Natalie, Sammy, and James) came to Longview Point with the
          intent of planting in Coldwater.
        </p>
        <div class="btn-row">
          <a class="btn btn-dark" href="/about">Read our story <Icon name="arrow" /></a>
          <a class="btn btn-outline" href="/partner">Partner with us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pulpit, Table, Square -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>How we make disciples: Pulpit, Table, Square</h2>
        </div>
        <a class="link-arrow" href="/about/life-at-redemption-coldwater">How we make disciples <Icon name="arrow" /></a>
      </div>
      <ol class="rhythms">
        {rhythms.map((r, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}>
            <img src={r.img} alt="" width="96" height="96" loading="lazy" />
            <h3 class="h3">{r.name}</h3>
            <p class="muted">{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="section section-sand">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Latest from the blog</h2>
          </div>
          <a class="link-arrow" href="/blog">View all posts <Icon name="arrow" /></a>
        </div>
        <div class="post-grid">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative; min-height: calc(100svh - var(--header-height)); display: flex; align-items: center;
    color: var(--color-on-dark); background: var(--color-ink); overflow: hidden;
  }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--hero-overlay); }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg { animation: hero-zoom 18s ease-out both; }
    @keyframes hero-zoom { from { transform: scale(1.08); } }
  }
  .hero-inner {
    position: relative; z-index: 2; display: grid; justify-items: center; text-align: center; gap: 22px;
    padding-top: calc(clamp(56px, 8vw, 80px) + var(--header-overhang)); padding-bottom: clamp(120px, 14vw, 180px);
  }
  .hero-logo { width: min(520px, 82vw); height: auto; }
  .hero-lede { font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-weight: 500; max-width: 44ch; color: color-mix(in srgb, var(--color-on-dark) 88%, transparent); }
  .hero-title { font-style: italic; font-size: clamp(2.4rem, 6.4vw, 5.25rem); line-height: 1.05; max-width: 15ch; }
  .hero-actions { justify-content: center; margin-top: 8px; }
  .hero-actions .btn-outline { white-space: normal; }
  .addr-short { display: none; }
  @media (max-width: 600px) { .addr-full { display: none; } .addr-short { display: inline; } }
  .hero-wave { position: absolute; z-index: 2; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(40px, 7vw, 110px); fill: var(--color-bg); }
  /* Keep hero buttons clear of the floating Plan a Visit button on phones */
  @media (max-width: 600px) { .hero-actions { padding-inline: 8px; } }

  .expect { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1000px) { .expect { grid-template-columns: 1fr 1fr; gap: 80px; } }
  .expect-copy { --stack: 22px; }
  .facts { list-style: none; padding: 0; display: grid; gap: 14px; margin-top: 8px; }
  .facts li { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; border-radius: var(--radius); background: var(--color-sand); }
  .facts :global(svg) { flex: none; color: var(--accent-text); margin-top: 2px; }
  .facts strong { color: var(--color-ink); }

  .series { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: 0 24px 60px rgb(2 26 38 / 0.10); }
  .series-media { aspect-ratio: 16 / 9; border-radius: 0; }
  .series-copy { --stack: 14px; padding: clamp(24px, 3vw, 36px); }
  .series-copy .btn { justify-self: start; margin-top: 6px; }

  .events-section .section-head { margin-bottom: clamp(32px, 5vw, 64px); }
  .events-all { margin-top: 48px; }
  .weekly { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius-lg); border: 1px solid color-mix(in srgb, var(--color-on-dark) 18%, transparent); }
  .weekly img { width: 56px; height: 56px; }

  .why { position: relative; color: var(--color-on-dark); background: var(--color-ink); padding-block: var(--section-space); overflow: hidden; }
  .why::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(2 26 38 / .92) 0%, rgb(2 26 38 / .7) 100%); }
  .why-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .why-inner { position: relative; z-index: 2; display: grid; gap: 40px; }
  @media (min-width: 960px) { .why-inner { grid-template-columns: 0.9fr 1.1fr; gap: 80px; align-items: start; } }
  .why-quote { font-family: var(--font-display); font-style: italic; font-weight: 700; font-size: clamp(1.3rem, 2.2vw, 1.7rem); color: var(--color-accent); }
  .why-copy { --stack: 18px; font-size: 1.08rem; color: color-mix(in srgb, var(--color-on-dark) 88%, transparent); }
  .why-copy strong { color: var(--color-accent); }

  .story { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 960px) { .story { grid-template-columns: 1fr 1fr; gap: 80px; } }
  .story-copy { --stack: 20px; }
  .story-media { aspect-ratio: 3 / 2; box-shadow: 0 24px 60px rgb(2 26 38 / 0.15); }

  .rhythms { list-style: none; padding: 0; display: grid; gap: 40px 32px; }
  @media (min-width: 800px) { .rhythms { grid-template-columns: repeat(3, 1fr); } }
  .rhythms li { display: grid; gap: 14px; justify-items: start; padding: 32px; border-radius: var(--radius-lg); border: 1px solid color-mix(in srgb, var(--color-on-dark) 18%, transparent); }
  .rhythms img { width: 72px; height: 72px; }

  .post-grid { display: grid; gap: 40px 28px; }
  @media (min-width: 760px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .post-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
