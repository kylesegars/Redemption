---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { settings, givingHref } from '../lib/settings';

const isPco = settings.giving.provider === 'planning-center' && settings.giving.url;
const external = settings.giving.provider === 'other' && settings.giving.url;

/* Page copy lives here so the layout stays locked. Edit freely. */
const ways = [
  { icon: 'hands', title: 'Pray', text: 'We need your prayers! Pray that God would bring people to be a part of the core group, that God would use us to see those who are lost become redeemed, and for us and our families that we would grow closer to each other, the Lord, and for protection and strength in the spiritual warfare that takes place when a new work of the Gospel begins. As we continue, we will communicate our prayer needs through social media and a monthly newsletter.' },
  { icon: 'heart', title: 'Provide', text: 'We need partners who would commit for 1–3 years financially. Our goal is to be self-sustaining in 2–3 years. If you would like to provide for specific needs (materials, food, equipment, etc.), please see the list of partnership options and other ways to partner.' },
  { icon: 'users', title: 'Participate', text: 'We need individuals, groups, and churches that would want to come and volunteer with activities, canvassing, construction, and other missional opportunities as we begin the work that God has laid before us to do.' },
] as const;

const levels = [
  { name: 'Faith', range: '$25 – $150' },
  { name: 'Hope', range: '$150 – $350' },
  { name: 'Love', range: '$500 – $1,000' },
];

const needs = [
  { title: 'Pastor health insurance', text: '$700/mo' },
  { title: 'Renovation labor & materials', text: 'Contact us for more info about specific projects' },
  { title: 'Items for events', text: 'Food, cups, plates, extension cords, volunteers, etc.' },
  { title: 'Signage', text: 'Indoor and outdoor' },
  { title: 'A/V equipment', text: 'Microphones, cords, stands, TVs, mounts, licenses, software, etc.' },
];
---
<BaseLayout title="Partner with a Church Plant in Coldwater, MS" description="Pray, provide, and participate in planting Redemption Church, a Southern Baptist church plant in Coldwater, Mississippi.">
  <PageHero
    title="Partner with a Church Plant in Coldwater, MS"
    lede="Every church plant is carried by people who pray, provide, and participate. We'd be honored to have you with us in this new gospel work in Coldwater."
  >
    <div class="btn-row">
      <a class="btn" href="#partner-form">Become a partner <Icon name="arrow" /></a>
      <a class="btn btn-outline" href={givingHref} target={external ? '_blank' : undefined} rel="noopener">Give online</a>
    </div>
  </PageHero>

  <!-- Ways to partner -->
  <section class="section">
    <div class="container">
      <h2 class="ways-heading">Three ways to partner</h2>
      <div class="ways">
        {ways.map((w, i) => (
          <div class="way" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="way-icon"><Icon name={w.icon} size={30} /></span>
            <h3 class="h2">{w.title}</h3>
            <p class="muted">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnership opportunities -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Monthly support levels</h2>
        </div>
        <blockquote class="verse">
          <p>“I thank my God in all my remembrance of you, always in every prayer of mine for you all making my prayer with joy, because of your partnership in the gospel from the first day until now.”</p>
          <cite>Philippians 1:3–5</cite>
        </blockquote>
      </div>
      <ul class="levels">
        {levels.map((l, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}>
            <h3 class="level-name">{l.name}<br /><span>Partner</span></h3>
            <p class="level-range">{l.range}</p>
            <p class="level-per">per month</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Specific needs -->
  <section class="section">
    <div class="container needs-wrap">
      <div class="stack">
        <h2>Help with a specific need</h2>
        <p class="lede">If you'd like to provide for a specific need, we'd be so grateful. Reach out and we'll share the details.</p>
        <div class="checks-box">
          <p class="checks-title">Make checks payable to:</p>
          <p><strong>Longview Point Baptist Church</strong><br />Memo: Coldwater Church Plant</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-dark" href={givingHref} target={external ? '_blank' : undefined} rel="noopener">Give online <Icon name="arrow" /></a>
        </div>
      </div>
      <ul class="needs">
        {needs.map((n) => (
          <li><h3 class="need-title">{n.title}</h3><p class="muted">{n.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Form -->
  <section class="section section-sand" id="partner-form">
    <div class="container form-wrap">
      <div class="stack">
        <h2>Become a partner</h2>
        <p class="lede">Tell us how you'd like to partner and we'll follow up personally.</p>
        {settings.email && <p class="muted">Or email <a href={`mailto:${settings.email}`}>{settings.email}</a>.</p>}
      </div>
      <form class="form form-card" name="partner" method="POST" action="/thanks?form=partner" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="partner" />
        <p class="hidden-field"><label>Skip: <input name="bot-field" /></label></p>
        <div class="form-row">
          <div class="field"><label for="p-name">Full name</label><input id="p-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="p-email">Email</label><input id="p-email" type="email" name="email" autocomplete="email" required /></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="p-phone">Phone (optional)</label><input id="p-phone" type="tel" name="phone" autocomplete="tel" /></div>
          <div class="field"><label for="p-org">Church or organization (optional)</label><input id="p-org" name="organization" /></div>
        </div>
        <fieldset class="field checks">
          <legend>I'm interested in…</legend>
          <label class="check"><input type="checkbox" name="interest" value="Pray" /> Praying</label>
          <label class="check"><input type="checkbox" name="interest" value="Monthly support" /> Monthly support</label>
          <label class="check"><input type="checkbox" name="interest" value="Specific need" /> A specific need</label>
          <label class="check"><input type="checkbox" name="interest" value="Volunteer" /> Volunteering</label>
          <label class="check"><input type="checkbox" name="interest" value="Church partnership" /> Church partnership</label>
        </fieldset>
        <div class="field"><label for="p-msg">Anything else?</label><textarea id="p-msg" name="message" rows="4"></textarea></div>
        <button class="btn" type="submit">Send <Icon name="send" /></button>
      </form>
    </div>
  </section>
</BaseLayout>

{isPco && <script is:inline src="https://js.churchcenter.com/modal/v1" defer></script>}

<style>
  .ways { display: grid; gap: 20px; }
  @media (min-width: 900px) { .ways { grid-template-columns: repeat(3, 1fr); } }
  .way { display: grid; gap: 16px; align-content: start; padding: clamp(28px, 3vw, 40px); border-radius: var(--radius-lg); border: 1px solid var(--color-line); }
  .way-icon { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-ink); }

  .verse { max-width: 520px; }
  .verse p { font-family: var(--font-display); font-weight: 700; font-style: italic; font-size: 1.15rem; line-height: 1.45; }
  .verse cite { display: block; margin-top: 10px; font-style: normal; font-weight: 600; font-size: .78rem; letter-spacing: .15em; text-transform: uppercase; color: var(--color-accent); }
  .levels { list-style: none; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 800px) { .levels { grid-template-columns: repeat(3, 1fr); } }
  .levels li { display: grid; gap: 6px; padding: 36px 32px; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--color-on-dark) 6%, transparent); border: 1px solid color-mix(in srgb, var(--color-on-dark) 16%, transparent); }
  .levels li:nth-child(2) { background: var(--color-accent); color: var(--color-ink); border-color: var(--color-accent); }
  .level-name { font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; line-height: 1.05; color: inherit; }
  .level-name span { font-size: 1rem; font-weight: 600; font-family: var(--font-body); letter-spacing: .2em; text-transform: uppercase; opacity: .75; }
  .level-range { font-family: var(--font-display); font-weight: 800; font-style: italic; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-top: 18px; }
  .level-per { font-size: .78rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; opacity: .75; }

  .needs-wrap { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .needs-wrap { grid-template-columns: 1fr 1fr; gap: 80px; } }
  .needs-wrap > .stack { --stack: 20px; }
  .checks-box { padding: 22px 24px; border-radius: var(--radius); background: var(--color-accent-soft); color: var(--color-ink); }
  .checks-title { font-size: .78rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 6px; }
  .needs { list-style: none; padding: 0; border-top: 1.5px solid var(--color-ink); }
  .needs li { display: grid; gap: 4px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
  .need-title { font-family: var(--font-body); font-weight: 700; color: var(--color-ink); font-size: 1.1rem; line-height: 1.4; }
  .ways-heading { margin-bottom: clamp(28px, 4vw, 48px); }

  .form-wrap { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .form-wrap { grid-template-columns: 0.9fr 1.1fr; gap: 72px; } }
  .form-wrap > .stack { --stack: 20px; }
  .form-wrap a { color: var(--accent-text); font-weight: 600; }
  .form-card { padding: clamp(24px, 4vw, 44px); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-line); }
</style>
