---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { settings } from '../lib/settings';
import { getTeam } from '../lib/content';

const team = await getTeam();
const city = settings.location.city ?? 'our city';

/* Page copy lives here so the layout stays locked. Edit freely. */
const values = [
  { title: 'Expositional preaching', text: 'We value the teaching of all Scripture faithfully and plainly through expositional preaching, so that people understand the whole story of the Bible and God’s redemption through Jesus.' },
  { title: 'Gathered worship', text: 'We value the weekly gathering as a faith family for worship through the preaching of the Word, prayer, singing, fellowship, giving, and the ordinances: the Lord’s Supper and baptism.' },
  { title: 'Community', text: 'We strive to be a close-knit faith family, with small groups where relationships are made and deepened through fellowship, learning, encouragement, and serving together.' },
  { title: 'Biblical leadership', text: 'We value a plurality of qualified pastor-elders who provide biblical oversight with the congregation’s affirmation, and deacons who serve the physical and logistical needs of the church.' },
  { title: 'Missions', text: 'We answer the Great Commission through acts of service, evangelism, church planting, and missionary partnerships, taking the gospel to our neighbors and around the world.' },
];

const beliefs = [
  { q: 'Southern Baptist', a: 'We are a Southern Baptist church plant, sent out by Longview Point Baptist Church in Hernando, Mississippi.' },
  { q: 'Abstract of Principles', a: 'We affirm the Abstract of Principles as a concise and specific summary of the beliefs and doctrines we hold.' },
  { q: 'Church leadership', a: 'We are a pastor-led, congregationally affirmed, deacon-served church, with believers equipped for gospel work. The office of Pastor/Elder is one of God’s designed offices for the healthy function of the church; deacons free the pastors to devote themselves to the Word, prayer, and equipping the saints for ministry.' },
];

const rhythms = [
  { name: 'Pulpit', shape: 'triangle', text: 'Our Sunday gathering centers on prayer, Scripture reading, corporate singing, the preaching of the Word, the ordinances, fellowship, and giving. Its direction is the worship of God and growth toward Him.' },
  { name: 'Table', shape: 'circle', text: 'In homes, coffee shops, or wherever a group can gather, we learn to live in authentic community. Community Groups (15–20 people) discuss the sermon, share a meal, and pray and care for one another. Life on Life Groups (3–5 people, same gender) help believers walk closer to Jesus.' },
  { name: 'Square', shape: 'square', text: 'The square is our community and world. We intentionally engage Coldwater and beyond through acts of service, evangelism, church planting, and missionary partnerships.' },
] as const;

const expect = [
  { icon: 'coffee', title: 'A warm welcome', text: 'Someone will meet you at the door. Come as you are and make yourself at home.' },
  { icon: 'music', title: 'Worship', text: 'We pray, read Scripture, and sing together as a faith family.' },
  { icon: 'book', title: 'Preaching', text: 'Faithful, plain, expositional preaching straight through books of the Bible.' },
  { icon: 'smile', title: 'Fellowship', text: 'Stick around afterward. We’d love to get to know you and your family.' },
] as const;
---
<BaseLayout title="About" description={`The story, beliefs, and people of ${settings.churchName}.`} overlayHeader>
  <PageHero
    eyebrow="About us"
    title="Love God. Love people. Make disciples."
    lede={`${settings.churchName} is a Southern Baptist church plant in ${city}, Mississippi. Here's who we are and why we're here.`}
    image="/images/site/story.svg"
  />

  <!-- Story -->
  <section class="section">
    <div class="container story">
      <div class="stack story-copy" data-reveal>
        <span class="eyebrow">Our story</span>
        <h2>A building given for the gospel</h2>
        <p class="lede">
          In 2023, Longview Point Baptist Church was given a building by a church that had shut its
          doors. The keys were handed over with the hope of seeing it filled and used once again to
          bring the gospel to Tate County.
        </p>
        <p>
          At the same time, Longview Point connected with Sam Henderson about becoming a church
          planting resident. In January 2024, Sam and his family (Natalie, Sammy, and James) came to
          Longview Point with the intent of planting in Coldwater.
        </p>
        <p>
          Since then, Sam has been building a core group: leading a community Bible study, canvassing,
          hosting events, and getting to know the town. Our hope is that anyone who walks through our
          doors feels welcomed, loved, and encouraged to follow Jesus.
        </p>
      </div>
      <div class="media story-media" data-reveal><img src="/images/site/community.svg" alt="" loading="lazy" /></div>
    </div>
  </section>

  <!-- Mission + values -->
  <section class="section section-dark">
    <div class="container">
      <div class="mission" data-reveal>
        <span class="eyebrow">Our mission &amp; core values</span>
        <p class="mission-text">We exist to <em>love God</em>, <em>love people</em>, and <em>make disciples</em> of Jesus Christ.</p>
      </div>
      <ol class="values">
        {values.map((v, i) => (
          <li data-reveal style={`transition-delay:${i * 70}ms`}>
            <span class="value-num">0{i + 1}</span>
            <h3 class="h3">{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Beliefs -->
  <section class="section">
    <div class="container beliefs">
      <div class="stack">
        <span class="eyebrow">What we believe</span>
        <h2>Our beliefs</h2>
        <p class="muted">The convictions that shape everything we do.</p>
      </div>
      <div class="accordion">
        {beliefs.map((b, i) => (
          <details open={i === 0}>
            <summary><span>{b.q}</span><Icon name="chevron-down" /></summary>
            <p>{b.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Life at Redemption: Pulpit, Table, Square -->
  <section class="section section-dark" id="life">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Life at Redemption</span>
          <h2>Pulpit. Table. Square.</h2>
        </div>
        <p class="lede">A simple approach to discipleship, where every area of church life is connected.</p>
      </div>
      <ol class="rhythms">
        {rhythms.map((r, i) => (
          <li data-reveal style={`transition-delay:${i * 70}ms`}>
            <svg class="rhythm-shape" viewBox="0 0 48 48" aria-hidden="true">
              {r.shape === 'triangle' && <path d="M6 10h36L24 40z" />}
              {r.shape === 'circle' && <circle cx="24" cy="24" r="17" />}
              {r.shape === 'square' && <rect x="8" y="8" width="32" height="32" />}
            </svg>
            <h3 class="h3">{r.name}</h3>
            <p class="muted">{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Leadership (from Keystatic → Team & Authors) -->
  {team.length > 0 && (
    <section class="section section-sand">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Our team</span>
            <h2>Leadership</h2>
          </div>
        </div>
        <ul class="team">
          {team.map((m, i) => (
            <li class="member" data-reveal style={`transition-delay:${i * 70}ms`}>
              <div class="media member-photo">
                <img src={m.data.photo ?? '/images/site/community.svg'} alt={m.data.name} loading="lazy" />
              </div>
              <h3 class="h3">{m.data.name}</h3>
              {m.data.role && <p class="member-role">{m.data.role}</p>}
              {m.data.bio && <p class="muted">{m.data.bio}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- What to expect -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Sundays</span>
          <h2>What to expect</h2>
        </div>
        <p class="lede">Your first visit anywhere can feel a little awkward. Here's what a Sunday looks like.</p>
      </div>
      <div class="expect">
        {expect.map((e) => (
          <div class="expect-card">
            <Icon name={e.icon} size={32} />
            <h3 class="h3">{e.title}</h3>
            <p class="muted">{e.text}</p>
          </div>
        ))}
      </div>
      {settings.location.arrival && (
        <div class="arrival">
          <Icon name="pin" />
          <p><strong>When you arrive:</strong> {settings.location.arrival}</p>
        </div>
      )}
    </div>
  </section>

  <CtaBand title="Come see for yourself" text="We'd love to meet you this Sunday.">
    <a class="btn" href="/contact#visit" data-plan-visit>Plan a visit <Icon name="arrow" /></a>
  </CtaBand>
</BaseLayout>

<style>
  .story { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 960px) { .story { grid-template-columns: 1fr 1fr; gap: 80px; } }
  .story-copy { --stack: 22px; }
  .story-media { aspect-ratio: 4 / 5; }

  .mission { max-width: 1000px; display: grid; gap: 24px; margin-bottom: clamp(56px, 8vw, 100px); }
  .mission-text {
    font-family: var(--font-display); font-weight: 600; font-stretch: 100%;
    font-size: clamp(1.9rem, 4vw, 3.4rem); line-height: 1.12;
  }
  .mission-text em { font-style: normal; color: var(--color-accent); }
  .values { list-style: none; padding: 0; display: grid; gap: 40px 32px; }
  @media (min-width: 700px) { .values { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .values { grid-template-columns: repeat(5, 1fr); } }
  .values li { display: grid; gap: 12px; align-content: start; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 25%, transparent); }
  .value-num { font-family: var(--font-display); font-weight: 800; font-stretch: var(--display-stretch); color: var(--color-accent); }

  .rhythms { list-style: none; padding: 0; display: grid; gap: 40px 32px; }
  @media (min-width: 860px) { .rhythms { grid-template-columns: repeat(3, 1fr); } }
  .rhythms li { display: grid; gap: 14px; align-content: start; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 25%, transparent); }
  .rhythm-shape { width: 44px; height: 44px; fill: none; stroke: var(--color-accent); stroke-width: 3; stroke-linejoin: round; }

  .beliefs { display: grid; gap: 40px; }
  @media (min-width: 960px) { .beliefs { grid-template-columns: 0.8fr 1.2fr; gap: 80px; } }
  .accordion { border-top: 1.5px solid var(--color-ink); }
  .accordion details { border-bottom: 1px solid var(--color-line); }
  .accordion summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 22px 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; font-stretch: var(--display-stretch);
    font-size: clamp(1.25rem, 2vw, 1.6rem); text-transform: var(--display-transform);
  }
  .accordion summary::-webkit-details-marker { display: none; }
  .accordion summary :global(svg) { flex: none; transition: transform .3s ease; }
  .accordion details[open] summary :global(svg) { transform: rotate(180deg); }
  .accordion details p { padding-bottom: 24px; max-width: 60ch; color: var(--color-ink-soft); font-size: 1.1rem; }

  .team { list-style: none; padding: 0; display: grid; gap: 48px 28px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .member { display: grid; gap: 8px; align-content: start; }
  .member-photo { aspect-ratio: 4 / 5; margin-bottom: 12px; }
  .member-role { font-weight: 700; color: var(--color-accent); font-size: 0.95rem; }

  .expect { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .expect-card { display: grid; gap: 14px; align-content: start; padding: 32px; border-radius: var(--radius); background: var(--color-surface); border: 1px solid var(--color-line); }
  .expect-card :global(svg) { color: var(--color-accent); }
  .arrival { display: flex; gap: 14px; margin-top: 28px; padding: 24px 28px; border-radius: var(--radius); background: var(--color-accent-soft); }
  .arrival :global(svg) { flex: none; margin-top: 2px; }
</style>
