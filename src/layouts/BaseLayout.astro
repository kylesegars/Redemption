---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlanVisit from '../components/PlanVisit.astro';
import Newsletter from '../components/Newsletter.astro';
import { settings } from '../lib/settings';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Show the newsletter band above the footer (when enabled in Church Info). */
  newsletter?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description = settings.tagline ?? '',
  image = '/images/site/og-image.jpg',
  newsletter = true,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} | ${settings.churchName}` : settings.churchName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#021a26" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {siteConfig.gaId && import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaId}`}></script>
        <script is:inline define:vars={{ gaId: siteConfig.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {newsletter && <Newsletter />}
    <Footer />
    <PlanVisit />

    <script is:inline>
      /*
       * Hide events whose end (or start) time has passed — even if the site
       * hasn't been rebuilt yet. Cards carry data-expires (epoch ms).
       * Elements with data-expire-keep (event detail pages) are marked
       * .is-past instead of being removed.
       */
      (function () {
        function sweep() {
          var now = Date.now(), changed = false;
          document.querySelectorAll('[data-expires]').forEach(function (el) {
            if (+el.getAttribute('data-expires') > now) return;
            if (el.hasAttribute('data-expire-keep')) { el.classList.add('is-past'); return; }
            (el.closest('[data-expire-wrap]') || el).remove();
            changed = true;
          });
          document.querySelectorAll('[data-event-list]').forEach(function (list) {
            var empty = list.parentElement.querySelector('[data-empty]');
            if (empty && !list.querySelector('[data-expires]')) empty.hidden = false;
          });
          if (changed) document.dispatchEvent(new Event('events:expired'));
        }
        sweep();
        setInterval(sweep, 60000);
      })();
    </script>
    <script>
      // Gentle scroll-reveal for elements marked [data-reveal]
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-visible'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
