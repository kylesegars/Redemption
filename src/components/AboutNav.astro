---
/** Sub-navigation shared by the About pages (reads the About children from site.config). */
import { siteConfig } from '../site.config';
const about = siteConfig.nav.find((n) => n.href === '/about');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
{about?.children && (
  <nav class="about-nav" aria-label="About">
    <div class="container">
      <ul>
        {about.children.map((c) => (
          <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  .about-nav { background: var(--color-sand); border-bottom: 1px solid var(--color-line); }
  .about-nav ul {
    list-style: none; padding: 0; margin: 0; display: flex; gap: 4px;
    overflow-x: auto; scrollbar-width: none;
  }
  .about-nav ul::-webkit-scrollbar { display: none; }
  .about-nav a {
    display: block; padding: 18px 14px; white-space: nowrap; text-decoration: none;
    font-family: var(--font-nav); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-ink-soft); border-bottom: 3px solid transparent;
  }
  .about-nav a:hover { color: var(--color-ink); }
  .about-nav a[aria-current='page'] { color: var(--color-ink); border-bottom-color: var(--color-accent); }
</style>
