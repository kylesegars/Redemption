---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { siteConfig } from '../site.config';
import { settings } from '../lib/settings';

interface Props {
  /** Header floats transparently over a full-bleed hero image (turns solid navy on scroll). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="container header-inner">
    <Logo />
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {siteConfig.nav.map((item) => (
          item.children ? (
            <li class="has-sub" data-dropdown>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              <button type="button" class="sub-toggle" aria-expanded="false" aria-label={`${item.label} menu`} data-dropdown-toggle>
                <Icon name="chevron-down" size={16} />
              </button>
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          )
        ))}
      </ul>
      <a class="btn nav-cta" href={siteConfig.navCta.href}>{siteConfig.navCta.label}</a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        <li><a href="/">Home</a></li>
        {siteConfig.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="mobile-sub">
                {item.children.filter((c) => c.href !== item.href).map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
        <li><a href={siteConfig.navCta.href}>{siteConfig.navCta.label}</a></li>
      </ul>
    </nav>
    <div class="mobile-meta">
      {settings.serviceTimes.map((s) => <p><strong>{s.day} · {s.time}</strong></p>)}
      {settings.location.street && <p class="muted">{settings.location.street}, {settings.location.city}, {settings.location.state}</p>}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-height);
    background: var(--color-ink); color: var(--color-on-dark);
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  .site-header.is-scrolled { box-shadow: 0 6px 24px rgb(2 26 38 / 0.25); }
  .site-header.overlay { position: fixed; inset: 0 0 auto; background: transparent; }
  .site-header.overlay.is-scrolled { background: var(--color-ink); }
  .header-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }

  .nav-desktop { display: none; align-items: center; gap: 22px; }
  .nav-desktop > ul { display: flex; align-items: center; gap: 2px; list-style: none; padding: 0; }
  .nav-desktop a:not(.btn) {
    display: block; padding: 10px 12px;
    font-family: var(--font-nav); font-weight: 600; font-size: 0.875rem;
    letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none;
    transition: color .2s ease;
  }
  .nav-desktop a:not(.btn):hover, .nav-desktop a[aria-current='page'] { color: var(--color-accent); }
  .nav-cta { min-height: 44px; padding: 10px 26px; }

  .has-sub { position: relative; display: flex; align-items: center; }
  .has-sub > a { padding-right: 2px !important; }
  .sub-toggle { display: grid; place-items: center; width: 28px; height: 36px; padding: 0; border: 0; background: none; color: inherit; }
  .sub-toggle :global(svg) { transition: transform .2s ease; }
  .sub {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 240px;
    list-style: none; padding: 10px; border-radius: var(--radius);
    background: var(--color-surface); color: var(--color-ink);
    box-shadow: 0 18px 40px rgb(2 26 38 / 0.22);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
  }
  .sub::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .has-sub:hover .sub-toggle :global(svg), .has-sub.open .sub-toggle :global(svg) { transform: rotate(180deg); }
  .sub a { border-radius: var(--radius-sm); padding: 10px 14px !important; letter-spacing: 0.08em !important; font-size: 0.8rem !important; }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--color-accent-soft); color: var(--color-ink) !important; }

  .menu-toggle {
    display: grid; place-items: center; width: 48px; height: 48px;
    border: 0; background: transparent; border-radius: 999px; color: inherit;
  }
  .menu-toggle :global(.icon-close) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.icon-open) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.icon-close) { display: block; }
  @media (min-width: 1080px) { .nav-desktop { display: flex; } .menu-toggle { display: none; } }

  .mobile-menu {
    position: fixed; inset: var(--header-height) 0 0; z-index: 49;
    background: var(--color-ink); color: var(--color-on-dark);
    padding: 24px var(--gutter); overflow-y: auto;
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  .mobile-menu > nav > ul > li > a {
    font-family: var(--font-display); font-weight: var(--display-weight);
    font-size: clamp(1.8rem, 8vw, 2.6rem); line-height: 1.25; text-decoration: none;
  }
  .mobile-sub { margin: 4px 0 12px; padding-left: 4px !important; }
  .mobile-sub a {
    font-family: var(--font-nav); font-weight: 600; font-size: 0.85rem;
    letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
    color: var(--color-accent); line-height: 2.2;
  }
  .mobile-meta { display: grid; gap: 4px; padding-bottom: 96px; }
  .mobile-meta .muted { color: color-mix(in srgb, var(--color-on-dark) 65%, transparent); }
  :global(body.menu-open) .site-header { background: var(--color-ink); }
  :global(body.menu-open) { overflow: hidden; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Desktop dropdowns: hover/focus open them; the chevron button toggles for touch + keyboard.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');
  const closeAll = () => dropdowns.forEach((d) => {
    d.classList.remove('open');
    d.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
  });
  dropdowns.forEach((d) => {
    const btn = d.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !d.classList.contains('open');
      closeAll();
      d.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', closeAll);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); closeAll(); } });
</script>
