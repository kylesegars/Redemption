---
import Icon from './Icon.astro';
import { siteConfig } from '../site.config';
import { settings, fullAddress } from '../lib/settings';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
/* Desktop: links split around the centered logo, like the original site. */
const split = Math.ceil(siteConfig.nav.length / 2);
const navLeft = siteConfig.nav.slice(0, split);
const navRight = siteConfig.nav.slice(split);
const socials = (['instagram', 'facebook', 'youtube'] as const).filter((k) => settings.social[k]);
const service = settings.serviceTimes[0];
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <!-- Desktop: nav | (badge) | nav -->
    <nav class="nav-desktop nav-left" aria-label="Main">
      <ul>
        {navLeft.map((item) => (
          item.children ? (
            <li class="has-sub" data-dropdown>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              <button type="button" class="sub-toggle" aria-expanded="false" aria-label={`${item.label} menu`} data-dropdown-toggle>
                <Icon name="chevron-down" size={16} />
              </button>
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          )
        ))}
      </ul>
    </nav>

    <nav class="nav-desktop nav-right" aria-label="Main (continued)">
      <ul>
        {navRight.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a class="btn nav-cta" href={siteConfig.navCta.href}>{siteConfig.navCta.label}</a></li>
      </ul>
    </nav>

    <!-- Circular logo: its center sits exactly on the header's bottom edge (all screen sizes) -->
    <a href="/" class="logo-badge" aria-label={`${settings.churchName} home`}>
      <img src="/images/site/logo-mark.png" alt="" width="200" height="200" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only" data-menu-label>Open menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<!-- Mobile / tablet menu: floating card over a dimmed, blurred page -->
<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true" inert>
  <div class="menu-backdrop" data-menu-close></div>
  <div class="menu-card" role="dialog" aria-modal="true" aria-label="Site menu" tabindex="-1">
    <nav aria-label="Mobile">
      <ul class="menu-links">
        <li style="--i:0"><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {siteConfig.nav.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            {item.children ? (
              <div class="menu-group" data-menu-group>
                <div class="menu-row">
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                  <button type="button" class="group-toggle" aria-expanded="false" aria-controls={`menu-sub-${i}`} aria-label={`Show ${item.label} pages`}>
                    <Icon name="chevron-down" size={18} />
                  </button>
                </div>
                <div class="menu-sub" id={`menu-sub-${i}`}>
                  <ul>
                    {item.children.filter((c) => c.href !== item.href).map((c) => (
                      <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="menu-foot" style={`--i:${siteConfig.nav.length + 1}`}>
      <div class="menu-actions">
        <a class="btn" href={siteConfig.navCta.href}>{siteConfig.navCta.label}</a>
        <a class="btn btn-outline" href="/contact#visit" data-plan-visit>Plan a visit</a>
      </div>
      {service && (
        <p class="menu-info">
          <Icon name="clock" size={16} />
          <span>{service.day} at {service.time}{fullAddress && <> · <a href={settings.location.mapUrl ?? '/contact'} target={settings.location.mapUrl ? '_blank' : undefined} rel="noopener">{settings.location.street}, {settings.location.city}</a></>}</span>
        </p>
      )}
      {socials.length > 0 && (
        <ul class="menu-socials">
          {socials.map((k) => (
            <li><a href={settings.social[k]!} target="_blank" rel="noopener"><Icon name={k} label={k} /></a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</div>

<style>
  /* ---- Bar --------------------------------------------------------------- */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-height);
    background: var(--color-ink); color: var(--color-on-dark);
    /* One shadow for the bar + logo circle together: drop-shadow follows their
       combined outline, so it only shows along the bottom edge and the circle's
       lower half. Slightly deeper once the page scrolls under the header. */
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.45)) drop-shadow(0 12px 22px rgb(0 0 0 / 0.55));
    transition: filter .3s ease;
  }
  .site-header.is-scrolled { filter: drop-shadow(0 3px 5px rgb(0 0 0 / 0.5)) drop-shadow(0 14px 26px rgb(0 0 0 / 0.6)); }
  .header-inner {
    position: relative; height: 100%;
    display: grid; grid-template-columns: 1fr var(--badge-size) 1fr; align-items: center;
    column-gap: 20px;
  }

  /* ---- Centered logo badge ------------------------------------------------ */
  .logo-badge {
    position: absolute; z-index: 2; left: 50%;
    top: calc(var(--header-height) - var(--badge-size) / 2);
    width: var(--badge-size); height: var(--badge-size); translate: -50% 0;
    display: grid; place-items: center; border-radius: 50%;
    background: var(--color-ink);
    transition: transform .25s ease;
  }
  .logo-badge:hover { transform: scale(1.03); }
  /* The mark image has transparent padding; oversize it so the R fills the circle */
  .logo-badge img { width: calc(var(--badge-size) * 1.2); height: auto; max-width: none; margin: calc(var(--badge-size) * -0.1); }

  /* ---- Desktop nav --------------------------------------------------------- */
  .nav-desktop { display: none; }
  .nav-desktop > ul { display: flex; align-items: center; gap: 4px; list-style: none; padding: 0; margin: 0; }
  .nav-left { grid-column: 1; }
  .nav-left > ul { justify-content: flex-end; }
  .nav-right { grid-column: 3; }
  .nav-right > ul { justify-content: flex-start; }
  .nav-desktop a:not(.btn) {
    display: block; padding: 10px 14px;
    font-family: var(--font-nav); font-weight: 600; font-size: 0.875rem;
    letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
    transition: color .2s ease;
  }
  .nav-desktop a:not(.btn):hover, .nav-desktop a[aria-current='page'] { color: var(--color-accent); }
  .nav-cta { min-height: 44px; padding: 10px 26px; margin-left: 10px; }

  .has-sub { position: relative; z-index: 3; display: flex; align-items: center; }
  .has-sub > a { padding-right: 2px !important; }
  .sub-toggle { display: grid; place-items: center; width: 28px; height: 36px; padding: 0; border: 0; background: none; color: inherit; }
  .sub-toggle :global(svg) { transition: transform .2s ease; }
  .sub {
    position: absolute; z-index: 10; top: calc(100% + 6px); left: 0; min-width: 240px;
    display: grid; gap: 2px; list-style: none; padding: 10px; border-radius: var(--radius);
    background: var(--color-surface); color: var(--color-ink);
    box-shadow: 0 18px 40px rgb(2 26 38 / 0.22);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
  }
  .sub::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .has-sub:hover .sub-toggle :global(svg), .has-sub.open .sub-toggle :global(svg) { transform: rotate(180deg); }
  .sub a { border-radius: var(--radius-sm); padding: 10px 14px !important; letter-spacing: 0.08em !important; font-size: 0.8rem !important; }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--color-accent-soft); color: var(--color-ink) !important; }

  /* ---- Menu button (animated burger ⇄ X) ------------------------------- */
  .menu-toggle {
    grid-column: 3; justify-self: end;
    display: grid; place-items: center; width: 48px; height: 48px;
    border: 0; border-radius: 50%; background: transparent; color: inherit;
  }
  .burger { position: relative; width: 26px; height: 14px; }
  .burger span {
    position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor;
    transition: transform .35s cubic-bezier(.7,0,.2,1), top .35s cubic-bezier(.7,0,.2,1), width .35s ease;
  }
  .burger span:first-child { top: 0; }
  .burger span:last-child { top: 12px; width: 70%; left: auto; }
  .menu-toggle[aria-expanded='true'] .burger span { top: 6px; width: 100%; }
  .menu-toggle[aria-expanded='true'] .burger span:first-child { transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .burger span:last-child { transform: rotate(-45deg); }

  @media (min-width: 1080px) {
    .nav-desktop { display: block; }
    .menu-toggle { display: none; }
  }

  /* ---- Mobile / tablet menu: floating card ---------------------------- */
  .mobile-menu { position: fixed; inset: 0; z-index: 45; visibility: hidden; transition: visibility 0s linear .35s; }
  .mobile-menu.is-open { visibility: visible; transition: none; }
  @media (min-width: 1080px) { .mobile-menu { display: none; } }

  .menu-backdrop {
    position: absolute; inset: 0;
    background: rgb(2 26 38 / 0.6);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    opacity: 0; transition: opacity .35s ease;
  }
  .mobile-menu.is-open .menu-backdrop { opacity: 1; }

  .menu-card {
    position: absolute; left: 12px; right: 12px; margin-inline: auto; max-width: 440px;
    top: calc(var(--header-height) + var(--header-overhang) + 12px);
    max-height: calc(100dvh - var(--header-height) - var(--header-overhang) - 24px);
    overflow-y: auto; overscroll-behavior: contain;
    padding: 10px 20px 20px; border-radius: 22px;
    background: #0a2837; color: var(--color-on-dark);
    border: 1px solid color-mix(in srgb, var(--color-accent) 16%, transparent);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45), 0 2px 0 rgb(255 255 255 / 0.04) inset;
    transform-origin: 50% 0;
    opacity: 0; transform: translateY(-10px) scale(0.97);
    transition: opacity .25s ease, transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .mobile-menu.is-open .menu-card { opacity: 1; transform: none; }
  /* The panel itself takes focus on open (no ring); links still show focus when tabbed to */
  .menu-card:focus { outline: none; }

  .menu-links { list-style: none; padding: 0; margin: 0; }
  .menu-links > li { border-bottom: 1px solid color-mix(in srgb, var(--color-on-dark) 10%, transparent); }
  .menu-links > li > a, .menu-row > a {
    display: flex; align-items: center; min-height: 54px; flex: 1;
    font-family: var(--font-nav); font-weight: 700; font-size: 0.95rem;
    letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none;
    transition: color .2s ease;
  }
  .menu-links a:hover, .menu-links a[aria-current='page'] { color: var(--color-accent); }
  .menu-row { display: flex; align-items: center; gap: 12px; }
  .group-toggle {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    border: 0; background: color-mix(in srgb, var(--color-on-dark) 8%, transparent); color: inherit;
    transition: background-color .2s ease, color .2s ease;
  }
  .group-toggle :global(svg) { transition: transform .3s ease; }
  .group-toggle[aria-expanded='true'] { background: var(--color-accent); color: var(--color-accent-ink); }
  .group-toggle[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }

  /* Collapsible sub-list: animates height via grid rows 0fr → 1fr */
  .menu-sub { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .menu-sub > ul { min-height: 0; overflow: hidden; list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent); }
  .menu-group.open .menu-sub { grid-template-rows: 1fr; }
  .menu-group.open .menu-sub > ul { margin-bottom: 12px; }
  .menu-sub a {
    display: block; padding: 9px 0; text-decoration: none;
    font-family: var(--font-body); font-weight: 500; font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-on-dark) 75%, transparent);
  }
  .menu-sub a:hover, .menu-sub a[aria-current='page'] { color: var(--color-accent); }

  .menu-foot { display: grid; gap: 16px; padding-top: 18px; }
  .menu-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .menu-actions .btn { min-height: 48px; padding-inline: 10px; }
  .menu-info { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: color-mix(in srgb, var(--color-on-dark) 70%, transparent); }
  .menu-info :global(svg) { flex: none; color: var(--color-accent); }
  .menu-info a { color: inherit; text-underline-offset: 3px; white-space: nowrap; }
  .menu-socials { list-style: none; padding: 0; margin: 0; display: flex; gap: 8px; }
  .menu-socials a {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: color-mix(in srgb, var(--color-on-dark) 8%, transparent);
    transition: background-color .2s ease, color .2s ease;
  }
  .menu-socials a:hover { background: var(--color-accent); color: var(--color-accent-ink); }
  .menu-socials :global(svg) { width: 18px; height: 18px; }

  /* Quick stagger as the card opens */
  .menu-links > li, .menu-foot { opacity: 0; transform: translateY(6px); transition: opacity .3s ease, transform .35s ease; }
  .mobile-menu.is-open .menu-links > li, .mobile-menu.is-open .menu-foot { opacity: 1; transform: none; transition-delay: calc(0.08s + var(--i, 0) * 0.035s); }
  @media (prefers-reduced-motion: reduce) {
    .menu-backdrop, .menu-card, .menu-links > li, .menu-foot { transition: none !important; transform: none !important; }
  }

  :global(body.menu-open) { overflow: hidden; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menu.toggleAttribute('inert', !open);
    document.body.classList.toggle('menu-open', open);
    // Focus the panel (not the first link) so touch browsers don't draw a focus ring on "Home";
    // keyboard users reach the links with the next Tab.
    if (open) menu.querySelector<HTMLElement>('.menu-card')?.focus({ preventScroll: true });
    else if (document.activeElement && menu.contains(document.activeElement)) toggle.focus({ preventScroll: true });
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // Close after choosing a destination (including in-page links and the Plan a Visit dialog)
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
  window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Expandable groups in the mobile menu (e.g. About)
  menu?.querySelectorAll<HTMLElement>('[data-menu-group]').forEach((g) => {
    const btn = g.querySelector<HTMLButtonElement>('.group-toggle');
    btn?.addEventListener('click', () => {
      const open = !g.classList.contains('open');
      g.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  // Desktop dropdowns: hover/focus open them; the chevron button toggles for touch + keyboard.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');
  const closeAll = () => dropdowns.forEach((d) => {
    d.classList.remove('open');
    d.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
  });
  dropdowns.forEach((d) => {
    const btn = d.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !d.classList.contains('open');
      closeAll();
      d.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', closeAll);
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    closeAll();
  });
</script>
