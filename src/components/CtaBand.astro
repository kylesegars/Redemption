---
/** Big closing call-to-action band. Put buttons in the default slot. */
interface Props { title: string; text?: string; image?: string }
const { title, text, image = '/images/site/sanctuary.jpg' } = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <div class="cta-inner on-image">
      <img src={image} alt="" loading="lazy" />
      <div class="cta-copy">
        <h2>{title}</h2>
        {text && <p class="lede">{text}</p>}
        <div class="btn-row"><slot /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: var(--section-space); }
  .cta-inner {
    position: relative; overflow: hidden; border-radius: var(--radius-lg);
    min-height: 460px; display: flex; align-items: flex-end;
    color: var(--color-on-dark);
  }
  .cta-inner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cta-inner::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(2 26 38 / .92), rgb(2 26 38 / .45)); }
  .cta-copy { position: relative; z-index: 2; display: grid; gap: 20px; padding: clamp(28px, 6vw, 72px); max-width: 780px; }
  .cta-copy .lede { color: color-mix(in srgb, var(--color-on-dark) 85%, transparent); }
</style>
