---
/**
 * Uses the logo uploaded in Keystatic (Church Info → Logo). The logo is
 * designed for dark backgrounds (the header and footer are navy).
 */
import { settings } from '../lib/settings';
interface Props { class?: string; size?: 'md' | 'lg'; /** "mark" = just the circular R. */ variant?: 'full' | 'mark' }
const { class: className, size = 'md', variant = 'full' } = Astro.props;
---
<a href="/" class:list={['logo', `logo-${size}`, className]} aria-label={`${settings.churchName} home`}>
  {variant === 'mark' ? (
    <img class="mark" src="/images/site/logo-mark.png" alt={settings.churchName} width="56" height="56" />
  ) : settings.logo ? (
    <img src={settings.logo} alt={settings.churchName} />
  ) : (
    <span class="logo-word">{settings.churchName}</span>
  )}
</a>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; color: inherit; flex: none; }
  .logo img { height: 52px; width: auto; }
  .logo-lg img { height: 72px; }
  @media (max-width: 600px) { .logo img { height: 44px; } }
  .logo img.mark { height: 76px; width: 76px; max-width: none; margin: -10px; }
  .logo-word { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 1.2rem; line-height: 1; }
</style>
