---
/**
 * Uses the logo uploaded in Keystatic (Church Info → Logo). Until one exists,
 * shows a placeholder mark + the church name as a wordmark.
 */
import { settings } from '../lib/settings';
interface Props { class?: string }
const { class: className } = Astro.props;
---
<a href="/" class:list={['logo', className]} aria-label={`${settings.churchName} home`}>
  {settings.logo ? (
    <img src={settings.logo} alt="" height="40" />
  ) : (
    <>
      <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="currentColor" />
        <path d="M20 9c3 5 8 7.5 8 14a8 8 0 0 1-16 0c0-3.5 2-5.5 3.5-7 .5 2.5 2 4 3.5 4.5-1-4.5 1-8.5 1-11.5z" fill="var(--color-accent)" />
      </svg>
      <span class="logo-word">{settings.churchName}</span>
    </>
  )}
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; }
  .logo img { height: 40px; width: auto; }
  .logo-mark { width: 36px; height: 36px; flex: none; }
  .logo-word {
    font-family: var(--font-display); font-weight: var(--display-weight);
    font-stretch: var(--display-stretch); text-transform: var(--display-transform);
    font-size: 1.15rem; letter-spacing: 0.01em; line-height: 1;
  }
</style>
