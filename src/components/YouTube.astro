---
/** Rendered for the "YouTube video" block staff can insert into posts/events. */
interface Props { url: string }
const { url } = Astro.props;
const id =
  url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/|live\/)([\w-]{11})/)?.[1] ?? '';
---
{id && (
  <div class="yt">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title="YouTube video"
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
)}
<style>
  .yt { aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: #000; margin-block: 2em; }
  .yt iframe { width: 100%; height: 100%; border: 0; }
</style>
