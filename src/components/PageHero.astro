---
/** Interior page hero: navy band with big title, optionally over a full-bleed photo. */
interface Props { title: string; lede?: string; image?: string; align?: 'left' | 'center' }
const { title, lede, image, align = 'left' } = Astro.props;
---
<section class:list={['page-hero', { 'has-image': image, center: align === 'center' }]}>
  {image ? (
    <img class="page-hero-bg" src={image} alt="" fetchpriority="high" />
  ) : (
    <svg class="page-hero-rings" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="190" /><circle cx="200" cy="200" r="150" /><circle cx="200" cy="200" r="110" />
    </svg>
  )}
  <div class="container page-hero-inner on-image">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; overflow: hidden;
    background: var(--color-ink); color: var(--color-on-dark);
    padding-block: calc(clamp(56px, 7vw, 96px) + var(--header-overhang)) clamp(56px, 7vw, 96px);
  }
  .page-hero-inner { position: relative; z-index: 2; display: grid; gap: 20px; justify-items: start; }
  .page-hero h1 { max-width: 20ch; }
  .center .page-hero-inner { justify-items: center; text-align: center; }
  .center h1, .center .lede { margin-inline: auto; }
  .page-hero .lede { color: color-mix(in srgb, var(--color-on-dark) 82%, transparent); }
  .has-image { min-height: min(70vh, 640px); display: flex; align-items: flex-end; padding-top: calc(var(--header-height) + 80px); }
  .has-image::before { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--hero-overlay); }
  .page-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-hero-rings {
    position: absolute; z-index: 1; right: -120px; top: 50%; translate: 0 -50%;
    width: min(620px, 90vw); fill: none; stroke: var(--color-accent); stroke-width: 10; opacity: 0.14;
  }
</style>
