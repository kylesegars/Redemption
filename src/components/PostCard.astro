---
import { formatDate } from '../lib/dates';
import { getAuthor, type PostEntry } from '../lib/content';
import { siteConfig, labelFor } from '../site.config';
interface Props { post: PostEntry; size?: 'default' | 'large'; /** Heading level for the title, to fit the page outline. */ level?: 2 | 3 }
const { post, size = 'default', level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const author = await getAuthor(post);
const d = post.data;
---
<article class:list={['post-card', size]} data-category={d.category}>
  <a href={`/blog/${post.id}`} class="post-link">
    <div class="post-media media">
      <img src={d.featuredImage} alt={d.featuredImageAlt ?? ''} loading={size === 'large' ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="post-body">
      <p class="post-meta">
        <span class="chip">{labelFor(siteConfig.blogCategories, d.category)}</span>
        <time datetime={d.publishedDate}>{formatDate(d.publishedDate)}</time>
      </p>
      <Heading class:list={[size === 'large' ? 'h2' : 'h3']}>{d.title}</Heading>
      <p class="post-excerpt">{d.excerpt}</p>
      {author && (
        <p class="post-author">
          {author.data.photo && <img src={author.data.photo} alt="" width="36" height="36" loading="lazy" />}
          <span>{author.data.name}</span>
        </p>
      )}
    </div>
  </a>
</article>

<style>
  .post-link { display: grid; gap: 20px; text-decoration: none; height: 100%; align-content: start; }
  .post-media { aspect-ratio: 3 / 2; border-radius: var(--radius); }
  .post-media img { transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .post-link:hover .post-media img { transform: scale(1.04); }
  .post-body { display: grid; gap: 12px; align-content: start; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 0.9rem; color: var(--color-ink-soft); }
  .post-link:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .post-excerpt { color: var(--color-ink-soft); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-author { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; margin-top: 4px; }
  .post-author img { border-radius: 50%; }

  .large .post-link { gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .large .post-link { grid-template-columns: 1.25fr 1fr; } }
  .large .post-media { aspect-ratio: 16 / 11; border-radius: var(--radius-lg); }
  .large h3 { font-size: clamp(2rem, 4vw, 3.4rem); }
  .large .post-excerpt { font-size: 1.15rem; -webkit-line-clamp: 4; }
</style>
