# ---- Keystatic storage ----------------------------------------------------
# Leave everything blank to edit content locally (npm run dev → /keystatic).
#
# Option A: Keystatic Cloud (staff log in with a Keystatic account; no GitHub needed)
#   Create a project at https://keystatic.cloud and paste "team/project" here.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
#
# Option B: GitHub mode (staff log in with their own GitHub accounts)
#   "owner/repo" of this site's repository. Keystatic will walk you through
#   creating the GitHub App the first time you visit /keystatic on the live site,
#   and it will give you the three KEYSTATIC_* secrets below for Netlify.
PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
